# --- Chat model ---
# openai | groq | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2

# --- Embeddings ---
# huggingface (free, local) | openai | ollama
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text

# --- Keys (only the provider you use) ---
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
VECTORSTORE_DIR=./data/faiss_index

# --- UI ---
API_URL=http://localhost:8000
